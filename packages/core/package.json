{
  "name": "@aharness/core",
  "version": "0.1.0",
  "description": "Codex (codex-rs) substrate for aharness FSMs: headless sole-WS-client runtime with dynamic_tools submit, owner input, rollback, and per-state hooks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alfredvc/aharness.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "bin": {
    "aharness": "./dist/cli/main.js",
    "aharness-completion": "./dist/cli/completionMain.js"
  },
  "files": [
    "dist",
    "scripts/codex-version-min.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --dir ../.. run sync:package-readmes && rimraf dist && tsc --build --force && pnpm --dir ../web-ui build && node scripts/postBuild.mjs",
    "clean": "tsc --build --clean",
    "verify:codex-bump": "esbuild scripts/verify-codex-bump.ts --bundle --platform=node --format=esm --packages=external --outfile=/tmp/aharness-core-verify-codex-bump.mjs && node /tmp/aharness-core-verify-codex-bump.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pnpm/tabtab": "^0.5.4",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.0",
    "npm-package-arg": "11.0.3",
    "semver": "^7.8.1",
    "shell-quote": "^1.8.3",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.3",
    "ws": "^8.18.0",
    "xstate": ">=5.19.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.0",
    "@types/semver": "^7.7.1",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.5.13"
  }
}
