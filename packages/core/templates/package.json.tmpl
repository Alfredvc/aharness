{
  "name": "__PROJECT_NAME__",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": ["fsms", "README.md"],
  "exports": {
    "./hello.fsm.js": "./fsms/hello.fsm.ts"
  },
  "scripts": {
    "start": "aharness run ./fsms/hello.fsm.ts",
    "verify": "aharness verify ./fsms/hello.fsm.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aharness/core": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "aharness": {
    "package": {
      "commands": {
        "hello": {
          "entry": "fsms/hello.fsm.ts",
          "description": "Run the scaffolded hello-world FSM."
        }
      }
    }
  }
}
