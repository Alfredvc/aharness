{
  "name": "@aharness/web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Browser tab UI for the headless aharness: consumes production state, SSE events, and reply attempts; fixtures remain for explicit demo and test flows.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && prettier --write ../core/src/ui/static/index.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "elkjs": "^0.11.1",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
